  "sequence_probe_01": {
    "actions": {
      "long_lever": {
        "completed": false,
        "observation": "释放方向不匹配，演示失败。",
        "reward": -7,
        "updates": {},
        "violations": []
      },
      "short_lever": {
        "observation": "机械钟完成有效演示。",
        "reward": 17,
        "updates": {},
        "violations": []
      },
      "static_display": {
        "observation": "静态结构展示已完成。",
        "reward": 7,
        "updates": {},
        "violations": []
      },
      "wind": {
        "observation": "储能完成，指示片清晰显示短杆。",
        "reward": 0,
        "updates": {
          "wound": true
        },
        "violations": []
      }
    },
    "design_note": "跨领域迁移：先行动才产生相关状态；储能耗时2，重复检查可能用尽窗口。",
    "design_version": "formal-tasks-draft-20261029-v1",
    "evaluator_only": true,
    "formal_matrix_authorized": false,
    "initial_state": {
      "wound": false
    },
    "public": {
      "case": "机械钟演示的储能与释放",
      "constraints": [
        "未储能时不得释放；演示允许复位，没有受保护原件。"
      ],
      "deadline": 4,
      "objective": "在4单位时间内完成一次有效演示，计入所有费用。",
      "options": {
        "long_lever": {
          "cost": 0,
          "description": "用长杆释放完成演示，要求已储能",
          "one_use": true,
          "reversible": true,
          "terminal": true,
          "time": 1
        },
        "short_lever": {
          "cost": 0,
          "description": "用短杆释放完成演示，要求已储能",
          "one_use": true,
          "reversible": true,
          "terminal": true,
          "time": 1
        },
        "static_display": {
          "cost": 0,
          "description": "交付静态结构展示",
          "one_use": true,
          "reversible": true,
          "terminal": true,
          "time": 1
        },
        "wind": {
          "cost": 0,
          "description": "储能，所需2单位时间；结束时可直接看见指示片",
          "one_use": true,
          "reversible": true,
          "terminal": false,
          "time": 2
        }
      },
      "scenario": "教学机械钟需先储能，储能后指示片才显示应使用长杆还是短杆释放。正确演示值17单位，只展示静态结构值7单位。储能前读取没有意义。",
      "sources": {
        "indicator": {
          "cost": 2,
          "description": "读取储能后的指示片；储能前没有指示",
          "time": 1
        },
        "manual": {
          "cost": 0,
          "description": "通用装配手册，不含当前储能后的指示",
          "time": 1
        }
      },
      "task_id": "sequence_probe_01"
    },
    "requirements": {
      "long_lever": {
        "wound": true
      },
      "short_lever": {
        "wound": true
      },
      "wind": {
        "wound": false
      }
    },
    "sources": {
      "indicator": [
        {
          "observation": "未储能，没有指示。",
          "when": {
            "wound": false
          }
        },
        {
          "observation": "指示片显示短杆。",
          "when": {
            "wound": true
          }
        }
      ],
      "manual": "手册说明两种指示均可能出现，不能预报本次指示。"
    },
    "split": "probe",
    "stream_id": "sequence"
  },
