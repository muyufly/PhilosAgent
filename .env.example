# Copy to .env and fill these before running a real task.
# No API calls are made by doctor/init/tests.
DEFAULT_MODEL=deepseek-flash
ANALYSIS_MODEL=deepseek-flash
GENERATION_MODEL=deepseek-flash
DEFAULT_JUDGE_MODEL=deepseek-flash
MSWEA_MODEL_NAME=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# DeepSeek Search & Fetch reuse the model key; no additional accounts needed.
WEB_SEARCH_PROVIDER=deepseek
WEB_ACCESS_PROVIDER=deepseek
# For other model providers, optionally set DEEPSEEK_API_KEY for these tools.
# DEEPSEEK_API_KEY=
# To use the original web tools, set search=serper and access=jina instead.
SERPER_API_KEY=
JINA_API_KEY=
